# Copy to .env and fill in. NEVER commit your real .env.

# ---- Market data source ----
# "paper"    = REAL market data from Binance/Bybit (no account) + paper execution
# "pyquotex" = real Quotex broker via vendor/pyquotex (requires credentials below)
MARKET_PROVIDER=paper

# ---- Quotex account (only needed when MARKET_PROVIDER=pyquotex) ----
# NOTE (multi-user): these are now just a fallback used only for a user who
# hasn't saved their own Quotex credentials via PUT /api/broker/credentials.
# Real per-user credentials are stored encrypted in PostgreSQL (see
# DATABASE_URL below).
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
# is_demo: true = demo account (safe), false = LIVE real money
QUOTEX_IS_DEMO=true

# ---- Multi-user auth (Phase 1) ----
# JWT_SECRET and SESSION_ENCRYPTION_KEY are auto-generated into your real
# .env the first time the backend starts if not already set — you do not
# need to fill these in. Do not change them after users have registered
# (it invalidates all logins) or after broker sessions are stored
# (it makes stored sessions undecryptable).
# JWT_SECRET=
# SESSION_ENCRYPTION_KEY=


# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Database (PostgreSQL) ----
# Standard SQLAlchemy URL. Local dev default assumes `docker compose up db`
# (see docker-compose.yml) or a local Postgres with a `qat_app`/`qat_app`
# role and a `qat` database already created.
DATABASE_URL=postgresql+psycopg://qat_app:qat_app@localhost:5432/qat
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=60
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- Server ----
HOST=127.0.0.1
PORT=8090
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
